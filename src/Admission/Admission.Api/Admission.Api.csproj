<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.6" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.6" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.OpenApi" Version="2.3.0" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.0.1" />
      <ProjectReference Include="..\Admission.DictionaryClient\Admission.DictionaryClient.csproj" />
      <ProjectReference Include="..\Admission.FileStorage\Admission.FileStorage.csproj" />
      <ProjectReference Include="..\Admission.Infrastructure\Admission.Infrastructure.csproj" />
      <ProjectReference Include="..\Admission.Messaging\Admission.Messaging.csproj" />
      <ProjectReference Include="..\Admission.Persistence\Admission.Persistence.csproj" />
    </ItemGroup>

</Project>
